{
  "model": "fable",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(python main.py)",
      "Bash(python -)",
      "Bash(python -m py_compile *)",
      "Bash(python -m pytest*)",
      "Bash(python tests/check_anonymized.py*)",
      "Bash(python .claude/hooks/py_compile_check.py*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/precompact_snapshot.py",
            "timeout": 30,
            "statusMessage": "Stand vor der Verdichtung sichern..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python tests/check_anonymized.py --quiet"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/py_compile_check.py"
          }
        ]
      }
    ]
  }
}
